      "derive": [
        {
          "comment": "OpenROAD CTS needs a max slew; the 2004 Liberty has none.",
          "out": "osu025/osu025_stdcells.lib",
          "src": ".src/osu025/latest/cadence/lib/tsmc025/signalstorm/osu025_stdcells.lib",
          "insert_after": "^\\s*library\\s*\\(",
          "text": "  default_max_transition : 1.5 ;"
        },
        {
          "comment": "OpenROAD rejects the obsolete same-layer TURN via rules. It also applies an old-style via rule OVERHANG along one axis only, so power-grid vias got no metal around the cut on the other axis (MOSIS rules need 0.15 um); state it as an ENCLOSURE instead (LEF 5.5 syntax).",
          "out": "osu025/osu025_stdcells.lef",
          "src": ".src/osu025/latest/cadence/lib/tsmc025/lib/osu025_stdcells.lef",
          "drop_block": ["^VIARULE TURN\\d+ GENERATE", "^END TURN\\d+"],
          "replace": [["^VERSION 5\\.4 ;", "VERSION 5.5 ;"],
                      ["^\\s*DIRECTION \\w+ ;\\n(\\s*WIDTH [^\\n]*)\\n(\\s*)OVERHANG ([\\d.]+) ;\\n\\s*METALOVERHANG [\\d.]+ ;", "\\2ENCLOSURE \\3 \\3 ;\\n\\1"]]
        },
        {
          "comment": "Tech-only LEF (upstream ships tech and cells in one file); KLayout rejects reading the cells twice.",
          "out": "osu025/osu025_tech.lef",
          "src": "osu025/osu025_stdcells.lef",
          "keep_until": "^MACRO ",
          "text": "END LIBRARY"
        }
      ],
