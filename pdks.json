          "src": "icsprout55/prtech/techLEF/N551P6M_ecos.lef",
          "insert_after": "^END MET2_MET1_VIA1_8",
          "text": "\nVIA MET2_MET1_VIA1_PH0 DEFAULT\n\tRESISTANCE 2.5000000000 ;\n\tLAYER MET1 ;\n\t\tRECT -0.085 -0.045 0.085 0.045 ;\n\tLAYER VIA1 ;\n\t\tRECT -0.045 -0.045 0.045 0.045 ;\n\tLAYER MET2 ;\n\t\tRECT -0.050 -0.085 0.050 0.085 ;\nEND MET2_MET1_VIA1_PH0\n\nVIA MET2_MET1_VIA1_PH1 DEFAULT\n\tRESISTANCE 2.5000000000 ;\n\tLAYER MET1 ;\n\t\tRECT -0.085 -0.045 0.085 0.045 ;\n\tLAYER VIA1 ;\n\t\tRECT -0.045 -0.045 0.045 0.045 ;\n\tLAYER MET2 ;\n\t\tRECT -0.085 -0.050 0.085 0.050 ;\nEND MET2_MET1_VIA1_PH1\n\nVIA MET2_MET1_VIA1_PV0 DEFAULT\n\tRESISTANCE 2.5000000000 ;\n\tLAYER MET1 ;\n\t\tRECT -0.045 -0.085 0.045 0.085 ;\n\tLAYER VIA1 ;\n\t\tRECT -0.045 -0.045 0.045 0.045 ;\n\tLAYER MET2 ;\n\t\tRECT -0.050 -0.085 0.050 0.085 ;\nEND MET2_MET1_VIA1_PV0\n\nVIA MET2_MET1_VIA1_PV1 DEFAULT\n\tRESISTANCE 2.5000000000 ;\n\tLAYER MET1 ;\n\t\tRECT -0.045 -0.085 0.045 0.085 ;\n\tLAYER VIA1 ;\n\t\tRECT -0.045 -0.045 0.045 0.045 ;\n\tLAYER MET2 ;\n\t\tRECT -0.085 -0.050 0.085 0.050 ;\nEND MET2_MET1_VIA1_PV1"
